import adb from 'adblock-fast';
import { readfile, writefile } from 'fs';
let ti = adb._test_internals;
writefile(adb.pkg.config_file, '# test configuration\n');
writefile(adb.pkg.run_file, '# test configuration\n');
adb.env.load('quiet');
adb.env.load_config = function() {};
ti.set_cfg('blocked_domain', 'local.example.org');
ti.set_cfg('canary_domains_icloud', true);
for (let parallel in [false, true]) {
	if (parallel) {
		let pending = [];
		ti.set_cfg('parallel_downloads', 4);
		ti.set_uloop({
			init: function() {}, end: function() {}, done: function() {}, timer: function() {},
			task: function(child, callback) {
				push(pending, function() { child({ send: callback }); });
				return {};
			},
			run: function() { for (let run in pending) run(); },
		});
	}
	let old = 'server=/previous.example.org/\n';
	writefile(ti.dns_output.file, old);
	writefile(ti.dns_output.cache, old);
	system(sprintf("gzip < '%s' > '%s'", ti.dns_output.file, ti.dns_output.gzip));
	let compressed = readfile(ti.dns_output.gzip);
	let orig_warn = global.warn, diagnostics = '';
	global.warn = function(...args) { diagnostics += join('', args); };
	let result = adb.start(['download']);
	global.warn = orig_warn;
	let ok = result.status == 'statusFail' && length(result.errors) == 2 &&
		result.errors[0].code == 'errorDownloadingList' && result.errors[0].info == 'Missing URL' &&
		result.errors[1].code == 'errorDownloadingList' && result.errors[1].info == 'Empty URL' &&
		index(diagnostics, 'Failed to download Missing URL') >= 0 &&
		index(diagnostics, 'Failed to download Empty URL') >= 0 &&
		readfile(ti.dns_output.file) == old && readfile(ti.dns_output.cache) == old &&
		readfile(ti.dns_output.gzip) == compressed;
	printf('%s: %s\n', parallel ? 'parallel' : 'serial', ok ? 'PASS' : 'FAIL');
}
